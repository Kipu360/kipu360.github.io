---
import Base from "../../layouts/Base.astro";
import { hero, problema, porQueAhora, queHacemos, servicios, arquitectura, piloto, cierre, DEMO_URL } from "../../data/contenido";
const pdf = "/deck/kipu360-deck.pdf";
---
<Base title="Presentación de Kipu360" description="Presentación de Kipu360: infraestructura de datos ambientales abierta y lista para la inteligencia artificial.">

  <div class="laminas">
    <section class="lamina on-dark lamina--hero">
      <div class="lamina__cuerpo hero__grid">
        <div>
          <img class="logo-blanco lamina__logo" src="/brand/logo.svg" alt="Kipu360" width="164" height="75" />
          <h1>{hero.titulo}</h1>
          <p class="lead">{hero.bajada}</p>
        </div>
        <img class="hero__mapa" src="/brand/peru.svg" alt="" width="608" height="887" />
      </div>
    </section>

    <section class="lamina seccion--clara">
      <div class="lamina__cuerpo problema__grid">
        <div>
          <p class="eyebrow">{problema.eyebrow}</p>
          <h2 class="titulo-doble">{problema.titulo.map((t) => <span>{t}</span>)}</h2>
          <p>{problema.texto}</p>
          <blockquote class="cita"><p>«{problema.cita}»</p><cite>{problema.fuente}</cite></blockquote>
        </div>
        <div>
          <ul class="nube">{problema.instituciones.map((i) => <li>{i}</li>)}</ul>
          <p class="nube__nota">{problema.nota}</p>
        </div>
      </div>
    </section>

    <section class="lamina on-dark">
      <div class="lamina__cuerpo">
        <p class="eyebrow">{porQueAhora.eyebrow}</p>
        <h2 class="titulo-doble">{porQueAhora.titulo.map((t) => <span>{t}</span>)}</h2>
        <ol class="linea">
          {porQueAhora.hitos.map((h) => (
            <li class={h.destacado ? "destacado" : ""}>
              <span class="linea__cuando">{h.fecha}</span>
              <h3>{h.titulo}</h3>
              <p>{h.texto}</p>
            </li>
          ))}
        </ol>
        <p class="lamina__cierre">{porQueAhora.cierre}</p>
      </div>
    </section>

    <section class="lamina seccion--blanca">
      <div class="lamina__cuerpo">
        <p class="eyebrow">{queHacemos.eyebrow}</p>
        <h2>{queHacemos.titulo}</h2>
        <div class="flujo">
          <ul class="flujo__col flujo__col--origen">{queHacemos.origenes.map((o) => <li>{o}</li>)}</ul>
          <span class="flujo__flecha" aria-hidden="true">→</span>
          <div class="flujo__nucleo">
            <span class="marca">KIPU360</span>
            {queHacemos.verbos.map((v) => <div><strong>{v.verbo}</strong><span>{v.detalle}</span></div>)}
          </div>
          <span class="flujo__flecha" aria-hidden="true">→</span>
          <ul class="flujo__col flujo__col--salida">{queHacemos.salidas.map((s) => <li><strong>{s.nombre}</strong><span>{s.detalle}</span></li>)}</ul>
        </div>
      </div>
    </section>

    <section class="lamina seccion--clara">
      <div class="lamina__cuerpo">
        <p class="eyebrow">{servicios.eyebrow}</p>
        <h2 class="titulo-doble">{servicios.titulo.map((t) => <span>{t}</span>)}</h2>
        <div class="servicios">
          {servicios.grupos.map((g) => (
            <div class="servicios__grupo"><h3>{g.nombre}</h3><ul>{g.items.map((i) => <li>{i}</li>)}</ul></div>
          ))}
          <div class="servicios__base">{servicios.base}</div>
        </div>
        <p class="servicios__nota">{servicios.nota}</p>
      </div>
    </section>

    <section class="lamina on-dark">
      <div class="lamina__cuerpo">
        <p class="eyebrow">{arquitectura.eyebrow}</p>
        <h2 class="titulo-doble">{arquitectura.titulo.map((t) => <span>{t}</span>)}</h2>
        <p>{arquitectura.donde}</p>
        <ol class="pipeline">
          {arquitectura.pasos.map((p) => <li class={p.destacado ? "destacado" : ""}><strong>{p.nombre}</strong><span>{p.detalle}</span></li>)}
        </ol>
        <p class="lamina__detalle">{arquitectura.detalle}</p>
        <ul class="chips">
          {arquitectura.formatos.map((f) => <li><img src={f.logo} alt="" width="22" height="22" />{f.nombre}</li>)}
        </ul>
      </div>
    </section>

    <section class="lamina seccion--clara">
      <div class="lamina__cuerpo">
        <p class="eyebrow">{piloto.eyebrow}</p>
        <h2 class="titulo-doble">{piloto.titulo.map((t) => <span>{t}</span>)}</h2>
        <p class="lead">{piloto.texto}</p>
        <ol class="linea">
          {piloto.pasos.map((p) => (
            <li class={p.abierto ? "abierto" : ""}>
              <span class="linea__cuando">{p.cuando}</span><h3>{p.nombre}</h3><p>{p.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="lamina on-dark lamina--hero">
      <div class="lamina__cuerpo hero__grid">
        <div>
          <p class="eyebrow">{cierre.eyebrow}</p>
          <h2 class="lamina__grande">{cierre.titulo}</h2>
          <p class="lead">{cierre.texto}</p>
          <div class="botones"><a class="boton" href={DEMO_URL}>Ver la demo →</a></div>
        </div>
        <img class="hero__mapa" src="/brand/peru.svg" alt="" width="608" height="887" />
      </div>
    </section>
  </div>
  <div class="barra barra--fin no-print">
    <div class="contenedor barra__fila">
      <a class="boton" href={pdf} download>Descargar PDF</a>
      <a class="boton boton--borde" href="/">Volver al inicio</a>
    </div>
  </div>
</Base>

<style is:global>
  .barra { background: var(--piel); padding-block: var(--s-3); }
  .barra__fila { display: flex; flex-wrap: wrap; gap: var(--s-2); justify-content: space-between; align-items: center; font-family: var(--font-titulo); font-weight: 500; color: var(--azul-oscuro); }
  .barra__titulo { font-family: var(--font-titulo); font-weight: 700; font-size: var(--fs-2); color: var(--azul-oscuro); margin: 0; }
  .barra__titulo small { font-weight: 500; font-size: 0.55em; color: var(--texto-suave); }
  .barra--fin { padding-block: var(--s-5); text-align: center; }
  .barra--fin .barra__fila { justify-content: center; }
  /* En pantalla es una página normal con secciones; solo el PDF se arma como láminas 16:9. */
  .lamina { padding-block: var(--s-6); position: relative; overflow: hidden; }
  .lamina__logo { display: none; }
  .lamina__cuerpo { width: min(100% - 2 * var(--s-3), var(--ancho)); margin-inline: auto; }
  .lamina--hero .hero__mapa { width: min(100%, 380px); }
  .lamina__cierre { margin-top: var(--s-4); font-family: var(--font-titulo); font-weight: 500; font-size: 1.25rem; }
  .lamina__detalle { margin-top: var(--s-3); max-width: 70ch; }
  .lamina__grande { font-size: var(--fs-3); }
  .on-dark .linea p { opacity: 1; }

  @media print {
    @page { size: 1280px 720px; margin: 0; }
    html, body { background: var(--piel); }
    body { display: block; min-height: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .lamina__logo { display: block; height: 56px; width: auto; margin-bottom: var(--s-4); }
    .lamina { display: flex; align-items: center; width: 1280px; height: 720px; min-height: 0; padding-block: 48px; break-after: page; page-break-after: always; }
    .lamina:last-child { break-after: auto; page-break-after: auto; }
    .lamina__cuerpo { width: 1140px; }
    h1 { font-size: 52px; }
    h2 { font-size: 36px; }
    .lamina__grande { font-size: 52px; }
    .lead { font-size: 19px; }
    .hero__grid { grid-template-columns: 1.25fr 0.75fr !important; }
    .hero__mapa { display: block !important; position: static !important; width: 330px !important; opacity: 0.95 !important; }
    .problema__grid { grid-template-columns: 1fr 1fr !important; }
    .flujo { grid-template-columns: 1fr auto 1.2fr auto 1fr !important; }
    .flujo__flecha { transform: none !important; }
    .servicios { grid-template-columns: repeat(4, 1fr) !important; }
    .pipeline { grid-template-columns: repeat(5, 1fr) !important; }
    .linea { grid-template-columns: repeat(4, 1fr) !important; }
    .linea::before { top: 9px !important; left: 9px !important; right: 9px !important; bottom: auto !important; width: auto !important; height: 2px !important; }
    .linea li { padding: var(--s-4) 0 0 0 !important; }
    .seccion, .servicios__titulo { margin: 0; }
  }
</style>
