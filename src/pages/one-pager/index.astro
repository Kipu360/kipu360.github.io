---
import Base from "../../layouts/Base.astro";
import { hero, onePager as o, DEMO_URL } from "../../data/contenido";
const pdf = "/one-pager/kipu360-one-pager.pdf";
---
<Base title="Resumen en una página · Kipu360" description="Kipu360 en una página.">

  <div class="hoja-fondo">
    <article class="hoja">
      <header class="hoja__banda on-dark">
        <img class="logo-blanco hoja__logo" src="/brand/logo.svg" alt="Kipu360" width="164" height="75" />
        <h1>{hero.titulo}</h1>
        <p>{o.bajada}</p>
      </header>

      <section class="hoja__arq">
        <p class="rotulo">Arquitectura · {o.arquitecturaRotulo}</p>
        <ol class="hoja__pipeline">
          {o.arquitectura.map((p) => <li class={p.destacado ? "destacado" : ""}><strong>{p.nombre}</strong><span>{p.detalle}</span></li>)}
        </ol>
      </section>

      <div class="hoja__cols">
        <div>
          <h2 class="rotulo">El problema</h2>
          <p>{o.problema}</p>

          <h2 class="rotulo">Qué hacemos</h2>
          <ol class="hoja__pasos">
            {o.queHacemos.map((q) => <li><strong>{q.verbo}</strong> {q.texto}</li>)}
          </ol>

          <h2 class="rotulo">{o.serviciosRotulo}</h2>
          <ul class="hoja__lista">{o.servicios.map((s) => <li>{s}</li>)}</ul>
          <p class="hoja__suave">{o.serviciosCierre}</p>
        </div>

        <aside>
          <div class="hoja__tarjeta hoja__tarjeta--azul">
            <h2 class="rotulo">Cómo trabajamos</h2>
            <p>{o.comoTrabajamos}</p>
            <a href={DEMO_URL}>Ver la demo →</a>
          </div>
          <div class="hoja__tarjeta">
            <h2 class="rotulo">Para quién</h2>
            <dl>{o.paraQuien.map((p) => <><dt>{p.nombre}</dt><dd>{p.texto}</dd></>)}</dl>
          </div>
          <div class="hoja__tarjeta">
            <h2 class="rotulo">Principios</h2>
            <ul class="hoja__lista">{o.principios.map((p) => <li>{p}</li>)}</ul>
          </div>
        </aside>
      </div>
    </article>
  </div>
  <div class="barra barra--fin no-print">
    <div class="contenedor barra__fila">
      <a class="boton" href={pdf} download>Descargar PDF</a>
      <a class="boton boton--borde" href="/">Volver al inicio</a>
    </div>
  </div>
</Base>

<style is:global>
  .barra { background: var(--piel); padding-block: var(--s-3); }
  .barra__fila { display: flex; flex-wrap: wrap; gap: var(--s-2); justify-content: space-between; align-items: center; font-family: var(--font-titulo); font-weight: 500; color: var(--azul-oscuro); }
  .barra__titulo { font-family: var(--font-titulo); font-weight: 700; font-size: var(--fs-2); color: var(--azul-oscuro); margin: 0; }
  .barra__titulo small { font-weight: 500; font-size: 0.55em; color: var(--texto-suave); }
  .barra--fin { padding-block: var(--s-5); text-align: center; }
  .barra--fin .barra__fila { justify-content: center; }

  .hoja-fondo { padding: var(--s-5) var(--s-2); }
  .hoja { width: min(100%, 210mm); margin-inline: auto; background: var(--blanco); box-shadow: 0 20px 50px -30px rgb(8 71 144 / 0.5); font-size: 0.95rem; line-height: 1.5; }
  .hoja p { max-width: none; }
  .hoja__banda { padding: 28px 32px 26px; }
  .hoja__logo { height: 40px; width: auto; margin-bottom: 18px; }
  .hoja__banda h1 { font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.1rem); max-width: 24ch; margin-bottom: 10px; }
  .hoja__banda p { margin: 0; }
  .rotulo { font-family: var(--font-titulo); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--azul); margin: 0 0 8px; }
  .hoja__arq { padding: 20px 32px; background: var(--piel); }
  .hoja__pipeline { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .hoja__pipeline li { background: var(--blanco); border: 1px solid var(--linea); border-radius: 10px; padding: 9px 10px; font-size: 0.8rem; line-height: 1.35; }
  .hoja__pipeline li strong { display: block; font-family: var(--font-titulo); color: var(--azul-oscuro); font-size: 0.88rem; margin-bottom: 2px; }
  .hoja__pipeline li.destacado { background: var(--azul); color: var(--blanco); border-color: var(--azul); }
  .hoja__pipeline li.destacado strong { color: var(--blanco); }
  .hoja__cols { display: grid; grid-template-columns: 1.35fr 1fr; gap: 24px; padding: 22px 32px 30px; }
  .hoja__cols h2.rotulo { margin-top: 14px; }
  .hoja__cols > div > h2.rotulo:first-child { margin-top: 0; }
  .hoja__pasos { margin: 0 0 6px; padding-left: 1.3em; display: grid; gap: 6px; }
  .hoja__pasos strong { font-family: var(--font-titulo); color: var(--azul-oscuro); }
  .hoja__lista { margin: 0 0 6px; padding-left: 1.1em; display: grid; gap: 4px; }
  .hoja__suave { color: var(--texto-suave); }
  .hoja__tarjeta { border: 1px solid var(--linea); border-radius: 12px; padding: 14px 16px; margin-bottom: 12px; background: var(--piel); }
  .hoja__tarjeta p { margin-bottom: 6px; }
  .hoja__tarjeta--azul { background: var(--azul-oscuro); color: var(--blanco); border-color: var(--azul-oscuro); }
  .hoja__tarjeta--azul .rotulo, .hoja__tarjeta--azul a { color: var(--cian); }
  .hoja__tarjeta--azul a { font-family: var(--font-titulo); font-weight: 700; }
  .hoja dl { margin: 0; }
  .hoja dt { font-family: var(--font-titulo); font-weight: 700; color: var(--azul-oscuro); }
  .hoja dd { margin: 0 0 6px; }
  @media (max-width: 760px) {
    .hoja__pipeline, .hoja__cols { grid-template-columns: 1fr; }
    .hoja__banda, .hoja__arq, .hoja__cols { padding-inline: 20px; }
  }

  @media print {
    @page { size: A4; margin: 0; }
    body { display: block; min-height: 0; background: var(--blanco); -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .hoja-fondo { padding: 0; }
    .hoja { width: 210mm; height: 297mm; overflow: hidden; box-shadow: none; font-size: 9.6pt; }
    .hoja__pipeline { grid-template-columns: repeat(5, 1fr) !important; }
    .hoja__cols { grid-template-columns: 1.35fr 1fr !important; }
    .hoja__banda h1 { font-size: 22pt; }
  }
</style>
