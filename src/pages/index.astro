---
import Base from "../layouts/Base.astro";
import GloboKipu from "../components/GloboKipu.astro";
import { empresa as e, portada as h, problema, onePager, servicios, piloto, arquitectura, DEMO_URL, GITHUB_URL, HF_URL } from "../data/contenido";

const iconos = [
  // Ordenamos: capas
  '<path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="m3 13 9 5 9-5"/><path d="m3 17.5 9 5 9-5" opacity=".5"/>',
  // Desplegamos: nube
  '<path d="M7 18h10a4 4 0 0 0 .6-7.95A6 6 0 0 0 6.1 9.1 4.5 4.5 0 0 0 7 18Z"/>',
  // Conectamos: nodos
  '<circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="m8.3 10.9 7.4-3.7M8.3 13.1l7.4 3.7"/>',
];
---
<Base>
  <section id="hero" class="portada">
    <div class="contenedor portada__grid">
      <div class="portada__texto">
        <h1>{h.titulo}</h1>
        <p class="lead">{h.bajada}</p>
        <div class="botones">
          <a class="boton" href="#que-hacemos">Qué hacemos</a>
        </div>
      </div>
      <GloboKipu />
    </div>
  </section>

  <section class="franja" aria-label="Estándares y formatos abiertos">
    <div class="contenedor franja__fila">
      <p>Construido sobre estándares abiertos</p>
      <ul>{arquitectura.formatos.map((f) => <li><img src={f.logo} alt="" width="26" height="26" />{f.nombre}</li>)}</ul>
    </div>
  </section>

  <section id="problema" class="bloque">
    <div class="contenedor problema">
      <div>
        <p class="eyebrow">El problema</p>
        <h2>{problema.titulo[0]} <em>{problema.titulo[1]}</em></h2>
        <p>{e.problema}</p>
      </div>
      <div class="problema__lado">
        <ul class="fuentes">{problema.instituciones.map((i) => <li>{i}</li>)}</ul>
        <blockquote class="cita">
          <p>«{problema.cita}»</p>
          <cite>{problema.fuente}</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <section id="que-hacemos" class="bloque">
    <div class="contenedor">
      <div class="qh">
        <div class="encabezado">
          <p class="eyebrow">Qué hacemos</p>
          <h2>Un solo lugar para toda la información ambiental del Perú.</h2>
          <p>{e.queHacemos[0]}</p>
        </div>
        <div class="ficha" aria-label="Ejemplo de trazabilidad de un dato">
          <div class="ficha__cabeza">
            <span class="ficha__punto"></span>
            <strong>{h.ficha.titulo}</strong>
          </div>
          <dl>
            {h.ficha.filas.map((f) => <div><dt>{f.campo}</dt><dd>{f.valor}</dd></div>)}
          </dl>
          <ul class="ficha__chips">{h.ficha.chips.map((c) => <li>{c}</li>)}</ul>
        </div>

      </div>
      <div class="bento">
        {onePager.queHacemos.map((q, i) => (
          <article class="tarjeta-b">
            <svg class="tarjeta-b__icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconos[i]} />
            <h3>{q.verbo.replace(".", "")}</h3>
            <p>{q.texto}</p>
          </article>
        ))}
        <article class="tarjeta-b tarjeta-b--ancha">
          <h3>Sobre esa base, los servicios</h3>
          <div class="servicios-b">
            {servicios.grupos.map((g) => (
              <div><h4>{g.nombre}</h4><ul>{g.items.map((i) => <li>{i}</li>)}</ul></div>
            ))}
          </div>
          <p class="nota">{servicios.nota}</p>
        </article>
      </div>
      <aside class="nota-caja"><strong>Estándares</strong><p>{e.estandares}</p></aside>
    </div>
  </section>

  <section id="como-trabajamos" class="bloque bloque--oscuro on-dark">
    <div class="contenedor">
      <div class="encabezado encabezado--ancho">
        <div><p class="eyebrow">Cómo trabajamos</p><h2>{piloto.titulo.join(" ")}</h2></div>
        <p>{piloto.texto} Sus datos son suyos y no se usan para entrenar modelos.</p>
      </div>
      <ol class="linea">
        {piloto.pasos.map((p) => (
          <li class={p.abierto ? "abierto" : ""}>
            <span class="linea__cuando">{p.cuando}</span>
            <h3>{p.nombre}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="para-quien" class="bloque">
    <div class="contenedor">
      <div class="encabezado encabezado--ancho">
        <div><p class="eyebrow">Para quién</p><h2>Organizaciones que trabajan con información del territorio.</h2></div>
        <p>{e.dondeSeAplica}</p>
      </div>
      <div class="tres">
        {onePager.paraQuien.map((p) => <article class="tarjeta-b"><h3>{p.nombre}</h3><p>{p.texto}</p></article>)}
      </div>
      <aside class="nota-caja"><strong>Modelo de negocio</strong><p>{e.modelo}</p></aside>
    </div>
  </section>

  <section id="nosotros" class="bloque">
    <div class="contenedor">
      <p class="eyebrow">Nosotros</p>
      <div class="nosotros">
        <div><h2>Misión</h2><p>{e.mision}</p></div>
        <div><h2>Visión</h2><p>{e.vision}</p></div>
      </div>
      <h2 class="principios__titulo">Principios</h2>
      <ul class="principios">
        {e.principios.map((p) => <li><strong>{p.nombre}</strong>{p.texto}</li>)}
      </ul>
    </div>
  </section>

  <section id="materiales" class="bloque">
    <div class="contenedor">
      <div class="cta">
        <div>
          <h2>Conozca Kipu360 con más detalle.</h2>
          <p>Descargue la presentación o el resumen ejecutivo, o vea el código y los datos abiertos.</p>
        </div>
        <div class="cta__acciones">
          {e.descargas.map((d) => (
            <a class="descarga" href={d.pdf} download>
              <span class="descarga__nombre">{d.nombre}</span>
              <span class="descarga__archivo">{d.archivo}</span>
            </a>
          ))}
          <div class="cta__enlaces">
            <a href={GITHUB_URL}>GitHub</a>
            <a href={HF_URL}>Hugging Face</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Portada */
  .portada { position: relative; overflow: hidden; background: var(--fondo-portada); color: var(--negro); padding-block: var(--s-5); }
  .portada__fig { margin: 0; justify-self: end; text-align: center; }
  .portada__fig figcaption { margin-top: var(--s-1); font-family: var(--font-titulo); font-weight: 700; font-size: 1rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--cian); }
  .encabezado--ancho { max-width: none; display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); align-items: end; }
  .encabezado--ancho h2 { margin: 0; }
  .encabezado--ancho > p { margin: 0; max-width: none; }
  .nota-caja { margin-top: var(--s-4); display: grid; grid-template-columns: 12rem 1fr; gap: var(--s-3); padding: var(--s-3); border-radius: 14px; background: var(--blanco); border: 1px solid var(--linea); }
  .nota-caja strong { font-family: var(--font-titulo); color: var(--azul); }
  .nota-caja p { margin: 0; font-size: 1rem; max-width: none; }
  .portada__grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.3fr 0.7fr; gap: var(--s-5); align-items: center; }
  /* Con el cuadro del catálogo visible (>1040 px), el globo pide 440 a 520 px para que el árbol quepa sin cortar notas. */
  @media (min-width: 1041px) { .portada__grid { grid-template-columns: minmax(0, 1fr) clamp(440px, 36vw, 520px); gap: var(--s-4); } }
  .portada h1 { color: var(--azul-oscuro); letter-spacing: -0.02em; font-size: clamp(2.1rem, 1.4rem + 2.6vw, 3.3rem); max-width: 21ch; }
  .portada .lead { color: var(--negro); max-width: 50ch; }
  .portada .boton--borde { background: transparent; color: var(--blanco); border-color: rgb(255 255 255 / 0.7); }
  .portada .boton--borde:hover { background: var(--blanco); color: var(--azul-oscuro); }
  .portada__mapa { width: min(100%, 380px); height: auto; filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.35)); }
  .qh { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--s-5); align-items: center; margin-bottom: var(--s-4); }
  .qh .encabezado { margin-bottom: 0; }
  .ficha { border: 1px solid var(--linea); box-shadow: 0 30px 60px -40px rgb(8 71 144 / 0.5); }

  .ficha { background: var(--blanco); color: var(--negro); border-radius: 18px; padding: var(--s-3); box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.6); }
  .ficha__cabeza { display: flex; align-items: center; gap: 0.6em; padding-bottom: var(--s-2); border-bottom: 1px solid var(--linea); font-family: var(--font-titulo); color: var(--azul-oscuro); }
  .ficha__punto { width: 10px; height: 10px; border-radius: 50%; background: var(--verde); box-shadow: 0 0 0 4px color-mix(in srgb, var(--verde) 25%, transparent); }
  .ficha dl { margin: var(--s-2) 0; display: grid; gap: 0; }
  .ficha dl div { display: grid; grid-template-columns: 7.5rem 1fr; gap: var(--s-2); padding: 0.7em 0; border-bottom: 1px dashed var(--linea); }
  .ficha dt { font-family: var(--font-titulo); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--azul); }
  .ficha dd { margin: 0; font-size: 0.98rem; }
  .ficha__chips { display: flex; flex-wrap: wrap; gap: 0.5em; list-style: none; margin: 0; padding: 0; }
  .ficha__chips li { font-size: 0.82rem; font-weight: 600; padding: 0.3em 0.8em; border-radius: 999px; background: color-mix(in srgb, var(--azul) 9%, var(--blanco)); color: var(--azul-oscuro); }

  /* Franja de estándares */
  .franja { background: var(--blanco); border-bottom: 1px solid var(--linea); padding-block: var(--s-3); }
  .franja__fila { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-2) var(--s-4); }
  .franja p { margin: 0; font-weight: 500; color: var(--texto-suave); font-size: var(--fs-0); }
  .franja ul { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); list-style: none; margin: 0; padding: 0; }
  .franja li { display: inline-flex; align-items: center; gap: 0.55em; font-family: var(--font-titulo); font-weight: 700; color: var(--azul-oscuro); font-size: 1.05rem; }
  .franja img { width: 26px; height: 26px; object-fit: contain; }

  /* Bloques: fondo continuo, separados por espacio */
  .bloque { padding-block: var(--s-6) 0; }
  .bloque--oscuro { margin-top: var(--s-6); padding-block: var(--s-6); background: var(--azul-oscuro); }
  #materiales { padding-bottom: var(--s-6); }
  .encabezado { max-width: 46rem; margin-bottom: var(--s-4); }
  h2 em { font-style: normal; color: var(--azul); }

  .problema { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); align-items: start; }
  .fuentes { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: var(--s-1); list-style: none; margin: 0 0 var(--s-3); padding: 0; }
  .fuentes { grid-auto-rows: 1fr; }
  .fuentes li { display: flex; align-items: center; justify-content: center; font-family: var(--font-titulo); font-weight: 500; font-size: 1.02rem; text-align: center; padding: 0.8em 0.5em; border: 1.5px dashed color-mix(in srgb, var(--azul-oscuro) 40%, transparent); border-radius: 10px; background: var(--blanco); color: var(--azul-oscuro); }

  .bento { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-3); }
  .tarjeta-b { background: var(--blanco); border: 1px solid var(--linea); border-radius: 18px; padding: var(--s-4) var(--s-3); }
  .tarjeta-b h3 { font-size: 1.35rem; }
  .tarjeta-b p { margin: 0; color: var(--texto-suave); font-size: 1.05rem; }
  .tarjeta-b__icono { width: 40px; height: 40px; color: var(--azul); margin-bottom: var(--s-2); }
  .tarjeta-b--ancha { grid-column: 1 / -1; background: linear-gradient(135deg, var(--blanco), color-mix(in srgb, var(--cian) 14%, var(--blanco))); }
  .servicios-b { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-3); margin-top: var(--s-2); }
  .servicios-b h4 { font-family: var(--font-titulo); font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--azul); margin: 0 0 0.5em; }
  .servicios-b ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3em; font-weight: 500; }
  .tarjeta-b .nota { margin-top: var(--s-3); }
  .estandares { margin-top: var(--s-3); color: var(--negro); max-width: 75ch; font-size: 1.05rem; }

  .tres { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-4); }
  .tres .tarjeta-b { background: none; border: 0; border-top: 3px solid var(--azul); border-radius: 0; padding: var(--s-2) 0 0; }
  .on-dark .encabezado p { opacity: 0.92; }

  .nosotros { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); }
  .principios__titulo { margin-top: var(--s-5); }
  .nosotros__vision { margin-top: var(--s-4); }
  .principios { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-4) var(--s-3); }
  .principios li { padding-left: var(--s-2); border-left: 3px solid var(--azul); font-size: 1rem; color: var(--texto-suave); }
  .principios strong { display: block; margin-bottom: 0.2em; }
  .principios strong { color: var(--negro); font-family: var(--font-titulo); }

  .cta { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--s-4); align-items: center; padding: var(--s-5); border-radius: 24px; background: var(--azul-oscuro); color: var(--blanco); }
  .cta h2 { color: var(--blanco); }
  .cta p { color: var(--blanco); opacity: 0.92; margin: 0; }
  .cta__acciones { display: grid; gap: var(--s-2); }
  .descarga { display: flex; justify-content: space-between; align-items: center; gap: var(--s-2); padding: var(--s-2) var(--s-3); border-radius: 14px; background: var(--blanco); color: var(--azul-oscuro); text-decoration: none; transition: transform 0.15s ease; }
  .descarga:hover { transform: translateX(4px); }
  .descarga__nombre { font-family: var(--font-titulo); font-weight: 700; font-size: 1.2rem; }
  .descarga__archivo { font-size: 0.9rem; color: var(--texto-suave); white-space: nowrap; }
  .descarga__archivo::after { content: "  ↓"; color: var(--azul); font-weight: 700; }
  .cta__enlaces { display: flex; gap: var(--s-3); padding-top: var(--s-1); }
  .cta__enlaces a { color: var(--blanco); font-family: var(--font-titulo); font-weight: 700; }

  @media (max-width: 900px) {
    .portada { padding-block: var(--s-3) var(--s-5); }
    .portada__grid, .problema, .nosotros, .cta { grid-template-columns: 1fr; }
    .bento, .tres { grid-template-columns: 1fr; }
    .servicios-b { grid-template-columns: 1fr 1fr; }
    .encabezado--ancho, .nota-caja { grid-template-columns: 1fr; gap: var(--s-2); }
    .principios { grid-template-columns: 1fr !important; }
    .qh { grid-template-columns: 1fr; }
    .cta { padding: var(--s-4) var(--s-3); }
  }
  @media (max-width: 480px) {
    .fuentes { grid-template-columns: 1fr 1fr; }
    .ficha dl div { grid-template-columns: 1fr; gap: 0.2em; }
  }
</style>
