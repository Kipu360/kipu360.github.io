---
import Base from "../layouts/Base.astro";
import { empresa as e, problema, queHacemos, onePager, servicios, piloto, DEMO_URL } from "../data/contenido";
---
<Base>
  <section id="hero" class="hero on-dark">
    <div class="contenedor hero__grid">
      <div>
        <h1>{e.titulo}</h1>
        <p class="lead">{e.bajada}</p>
        <div class="botones">
          <a class="boton" href="#que-hacemos">Qué hacemos</a>
          <a class="boton boton--borde" href={DEMO_URL}>Ver la demo</a>
        </div>
      </div>
      <img class="hero__mapa" src="/brand/peru.svg" alt="" width="608" height="887" />
    </div>
  </section>

  <section id="problema" class="seccion seccion--clara">
    <div class="contenedor problema__grid">
      <div>
        <p class="eyebrow">El problema</p>
        <h2 class="titulo-doble">{problema.titulo.map((t) => <span>{t}</span>)}</h2>
        <p>{e.problema}</p>
        <blockquote class="cita">
          <p>«{problema.cita}»</p>
          <cite>{problema.fuente}</cite>
        </blockquote>
      </div>
      <ul class="nube" aria-label="Instituciones que publican información ambiental">
        {problema.instituciones.map((i) => <li>{i}</li>)}
      </ul>
    </div>
  </section>

  <section id="que-hacemos" class="seccion seccion--blanca">
    <div class="contenedor">
      <div class="dos-col">
        <div>
          <p class="eyebrow">Qué hacemos</p>
          <h2>{queHacemos.titulo}</h2>
        </div>
        <div>
          {e.queHacemos.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="pilares">
        {onePager.queHacemos.map((q) => (
          <article class="pilar">
            <h3>{q.verbo.replace(".", "")}</h3>
            <p>{q.texto}</p>
          </article>
        ))}
      </div>
      <p class="estandares">{e.estandares}</p>
    </div>
  </section>

  <section id="servicios" class="seccion seccion--clara">
    <div class="contenedor">
      <p class="eyebrow">Servicios</p>
      <h2 class="titulo-doble">{servicios.titulo.map((t) => <span>{t}</span>)}</h2>
      <div class="servicios">
        {servicios.grupos.map((g) => (
          <div class="servicios__grupo">
            <h3>{g.nombre}</h3>
            <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
        <div class="servicios__base">{servicios.base}</div>
      </div>
    </div>
  </section>

  <section id="como-trabajamos" class="seccion on-dark">
    <div class="contenedor">
      <p class="eyebrow">Cómo trabajamos</p>
      <h2 class="titulo-doble">{piloto.titulo.map((t) => <span>{t}</span>)}</h2>
      <p class="lead">{piloto.texto} Sus datos son suyos y no se usan para entrenar modelos.</p>
      <ol class="linea">
        {piloto.pasos.map((p) => (
          <li class={p.abierto ? "abierto" : ""}>
            <span class="linea__cuando">{p.cuando}</span>
            <h3>{p.nombre}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="para-quien" class="seccion seccion--blanca">
    <div class="contenedor">
      <div class="dos-col">
        <div>
          <p class="eyebrow">Para quién</p>
          <h2>Organizaciones que trabajan con información del territorio.</h2>
        </div>
        <p>{e.dondeSeAplica}</p>
      </div>
      <div class="pilares">
        {onePager.paraQuien.map((p) => (
          <article class="pilar pilar--claro">
            <h3>{p.nombre}</h3>
            <p>{p.texto}</p>
          </article>
        ))}
      </div>
      <p class="estandares">{e.modelo}</p>
    </div>
  </section>

  <section id="nosotros" class="seccion seccion--clara">
    <div class="contenedor">
      <p class="eyebrow">Nosotros</p>
      <div class="mv">
        <div><h2>Misión</h2><p>{e.mision}</p></div>
        <div><h2>Visión</h2><p>{e.vision}</p></div>
      </div>
      <h2 class="principios__titulo">Principios</h2>
      <div class="principios">
        {e.principios.map((p) => (
          <article><h3>{p.nombre}</h3><p>{p.texto}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section id="materiales" class="seccion seccion--blanca">
    <div class="contenedor">
      <p class="eyebrow">Materiales</p>
      <h2>Para conocernos con más detalle.</h2>
      <div class="descargas">
        {e.descargas.map((d) => (
          <a class="descarga" href={d.pdf} download>
            <span class="descarga__nombre">{d.nombre}</span>
            <span class="descarga__detalle">{d.detalle}</span>
            <span class="descarga__archivo">Descargar ({d.archivo})</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero h1 { max-width: 20ch; }
  .dos-col { display: grid; grid-template-columns: 1fr 1.1fr; gap: var(--s-5); align-items: start; }
  .dos-col h2 { margin: 0; }
  .pilares { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-3); margin-top: var(--s-5); }
  .pilar { background: var(--azul); color: var(--blanco); border-radius: var(--radio); padding: var(--s-4) var(--s-3); }
  .pilar h3 { color: var(--blanco); font-size: 1.6rem; }
  .pilar p { margin: 0; }
  .pilar--claro { background: var(--piel); color: var(--negro); border: 1px solid var(--linea); }
  .pilar--claro h3 { color: var(--azul-oscuro); font-size: 1.35rem; }
  .estandares { margin-top: var(--s-4); color: var(--texto-suave); max-width: 75ch; }
  .mv { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); }
  .mv p { font-size: 1.15rem; }
  .principios__titulo { margin-top: var(--s-5); }
  .principios { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: var(--s-3) var(--s-4); }
  .principios article { border-top: 3px solid var(--azul); padding-top: var(--s-2); }
  .principios h3 { font-size: 1.1rem; margin-bottom: 0.4em; }
  .principios p { font-size: 1rem; color: var(--texto-suave); margin: 0; }
  .descargas { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); margin-top: var(--s-4); }
  .descarga { display: grid; gap: var(--s-1); padding: var(--s-4); border-radius: var(--radio); background: var(--piel); border: 1px solid var(--linea); text-decoration: none; color: var(--negro); transition: transform 0.15s ease, box-shadow 0.15s ease; }
  .descarga:hover { transform: translateY(-3px); box-shadow: 0 14px 34px -18px rgb(8 71 144 / 0.45); }
  .descarga__nombre { font-family: var(--font-titulo); font-weight: 700; font-size: 1.6rem; color: var(--azul-oscuro); }
  .descarga__detalle { color: var(--texto-suave); }
  .descarga__archivo { font-family: var(--font-titulo); font-weight: 700; color: var(--azul); margin-top: var(--s-1); }
  @media (max-width: 860px) {
    .dos-col, .mv, .descargas { grid-template-columns: 1fr; gap: var(--s-3); }
    .pilares { grid-template-columns: 1fr; }
  }
</style>
