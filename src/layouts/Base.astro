---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/bloques.css";

interface Props { title?: string; description?: string; }
const {
  title = "Kipu360",
  description = "Infraestructura de datos ambientales abierta y lista para la inteligencia artificial.",
} = Astro.props;
const year = new Date().getFullYear();
const ruta = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/space-grotesk-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plus-jakarta-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="cabecera no-print">
      <div class="contenedor cabecera__fila">
        <a href="/" aria-label="Kipu360, inicio">
          <img src="/brand/logo.svg" alt="Kipu360" width="164" height="75" />
        </a>
        <nav aria-label="Principal">
          <a href="/deck/" aria-current={ruta.startsWith("/deck") ? "page" : undefined}>Presentación</a>
          <a href="/one-pager/" aria-current={ruta.startsWith("/one-pager") ? "page" : undefined}>Resumen</a>
        </nav>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="pie on-dark no-print">
      <div class="contenedor pie__fila">
        <img class="logo-blanco" src="/brand/logo.svg" alt="" width="120" height="55" />
        <p>© {year} Kipu360. Empresa peruana de tecnología.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .cabecera { padding-block: var(--s-3); border-bottom: 1px solid var(--linea); background: var(--blanco); }
  .cabecera__fila { display: flex; align-items: center; justify-content: space-between; }
  .cabecera img { height: 48px; width: auto; }
  .pie { padding-block: var(--s-4); border-top: 1px solid rgb(255 255 255 / 0.2); }
  nav { display: flex; gap: var(--s-3); }
  nav a { font-family: var(--font-titulo); font-weight: 500; text-decoration: none; color: var(--azul-oscuro); }
  nav a:hover, nav a[aria-current="page"] { color: var(--azul); text-decoration: underline; text-underline-offset: 0.35em; text-decoration-thickness: 2px; }
  @media (max-width: 400px) { nav { gap: var(--s-2); } nav a { font-size: 0.95rem; } .cabecera img { height: 40px; } }
  @media print { .no-print { display: none !important; } }
  .pie__fila { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: center; justify-content: space-between; }
  .pie p { margin: 0; font-size: var(--fs-0); }
  .pie img { height: 40px; width: auto; }
</style>
