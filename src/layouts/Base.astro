---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/bloques.css";
import { DEMO_URL, GITHUB_URL, HF_URL } from "../data/contenido";

interface Props { title?: string; description?: string; noindex?: boolean; }
const {
  noindex = false,
  title = "Kipu360",
  description = "Infraestructura de datos ambientales abierta y lista para la inteligencia artificial.",
} = Astro.props;
const year = new Date().getFullYear();
const ruta = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/space-grotesk-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plus-jakarta-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="cabecera no-print">
      <div class="contenedor cabecera__fila">
        <a href="/" aria-label="Kipu360, inicio">
          <img class="logo" src="/brand/logo-claro.svg" alt="Kipu360" width="164" height="75" />
        </a>
        <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-hidden="true" tabindex="-1" />
        <label for="menu-toggle" class="menu-boton" aria-label="Abrir menú"><span></span><span></span><span></span></label>
        <nav aria-label="Principal">
          <a href="/#que-hacemos">Qué hacemos</a>
          <a href="/#como-trabajamos">Cómo trabajamos</a>
          <a href="/#para-quien">Para quién</a>
          <a href="/#nosotros">Nosotros</a>
          <a href="/#materiales">Materiales</a>
        </nav>
        <div class="acciones">
          <a class="icono" href={GITHUB_URL} aria-label="Kipu360 en GitHub" title="GitHub"><img src="/brand/social/github.svg" alt="" width="22" height="22" /></a>
          <a class="icono" href={HF_URL} aria-label="Kipu360 en Hugging Face" title="Hugging Face"><img src="/brand/social/huggingface.svg" alt="" width="24" height="22" /></a>
          <a class="boton boton--chico" href={DEMO_URL}>Ver la demo</a>
        </div>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="pie on-dark no-print">
      <div class="contenedor pie__grid">
        <div>
          <img class="logo-blanco" src="/brand/logo.svg" alt="Kipu360" width="120" height="55" />
          <p>Infraestructura para organizar y utilizar la información ambiental y geoespacial.</p>
        </div>
        <div>
          <p class="pie__titulo">Secciones</p>
          <ul>
            <li><a href="/#que-hacemos">Qué hacemos</a></li>
            <li><a href="/#para-quien">Para quién</a></li>
            <li><a href="/#como-trabajamos">Cómo trabajamos</a></li>
            <li><a href="/#nosotros">Nosotros</a></li>
          </ul>
        </div>
        <div>
          <p class="pie__titulo">Materiales</p>
          <ul>
            <li><a href="/deck/kipu360-deck.pdf" download>Presentación (PDF)</a></li>
            <li><a href="/one-pager/kipu360-one-pager.pdf" download>Resumen ejecutivo (PDF)</a></li>
            <li><a href={DEMO_URL}>Demo</a></li>
          </ul>
        </div>
        <div>
          <p class="pie__titulo">Código y datos</p>
          <ul>
            <li><a href={GITHUB_URL}>GitHub</a></li>
            <li><a href={HF_URL}>Hugging Face</a></li>
          </ul>
        </div>
      </div>
      <div class="contenedor pie__legal"><p>© {year} Kipu360. Empresa peruana de tecnología.</p></div>
    </footer>
  </body>
</html>

<style>
  .cabecera { padding-block: var(--s-2); border-bottom: 1px solid var(--linea); background: var(--blanco); }
  .cabecera__fila { display: flex; align-items: center; justify-content: space-between; }
  .cabecera .logo { height: 46px; width: auto; }
  .menu-toggle, .menu-boton { display: none; }
  .pie { padding-block: var(--s-4); border-top: 1px solid rgb(255 255 255 / 0.2); }
  .cabecera { position: sticky; top: 0; z-index: 20; }
  nav { display: flex; gap: var(--s-3); margin-left: auto; margin-right: var(--s-4); }
  .acciones { display: flex; align-items: center; gap: var(--s-2); }
  .icono { display: inline-flex; width: 38px; height: 38px; align-items: center; justify-content: center; border-radius: 50%; color: var(--negro); transition: background 0.15s ease; }
  .icono:hover { background: var(--piel); }
  .icono img { width: 22px; height: 22px; }
  .boton--chico { padding: 0.55em 1.1em; }
  nav a { font-family: var(--font-titulo); font-weight: 500; text-decoration: none; color: var(--azul-oscuro); }
  nav a:hover { color: var(--azul); text-decoration: underline; text-underline-offset: 0.35em; text-decoration-thickness: 2px; }
  @media (max-width: 860px) {
    .cabecera__fila { flex-wrap: wrap; }
    .cabecera .logo { height: 38px; }
    .menu-boton { display: inline-flex; flex-direction: column; justify-content: center; gap: 5px; width: 42px; height: 42px; padding: 10px; border-radius: 10px; cursor: pointer; order: 2; margin-left: auto; }
    .menu-boton span { display: block; height: 2px; background: var(--azul-oscuro); border-radius: 2px; transition: transform 0.2s ease, opacity 0.2s ease; }
    .acciones { order: 1; margin-left: auto; margin-right: var(--s-1); }
    .boton--chico { display: none; }
    nav { order: 3; display: none; width: 100%; flex-direction: column; gap: 0; margin: var(--s-2) 0 0; border-top: 1px solid var(--linea); }
    nav a { padding: 0.85em 0; border-bottom: 1px solid var(--linea); font-size: 1.05rem; }
    .menu-toggle:checked ~ nav { display: flex; }
    .menu-toggle:checked + .menu-boton span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .menu-toggle:checked + .menu-boton span:nth-child(2) { opacity: 0; }
    .menu-toggle:checked + .menu-boton span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
  @media print { .no-print { display: none !important; } }
  .pie__grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: var(--s-4); }
  .pie p { margin: 0 0 var(--s-1); font-size: var(--fs-0); max-width: 34ch; }
  .pie img { height: 40px; width: auto; margin-bottom: var(--s-2); }
  .pie__titulo { font-family: var(--font-titulo); font-weight: 700; color: var(--cian); letter-spacing: 0.06em; text-transform: uppercase; font-size: 0.85rem !important; }
  .pie ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4em; }
  .pie ul a { color: var(--blanco); text-decoration: none; font-size: var(--fs-0); }
  .pie ul a:hover { text-decoration: underline; color: var(--cian); }
  .pie__legal { margin-top: var(--s-4); padding-top: var(--s-2); border-top: 1px solid rgb(255 255 255 / 0.2); }
  .pie__legal p { opacity: 0.85; max-width: none; }
  @media (max-width: 760px) { .pie__grid { grid-template-columns: 1fr; } }
</style>
