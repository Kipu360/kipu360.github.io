---
// Globo de puntos que gira, se acerca al Perú y a Camisea (Cusco), y abre un ejemplo de la
// estructura de catálogo que proponemos. Es ilustrativo: no hay datos de clientes. Ubicación de
// los campos de Camisea según en.wikipedia.org/wiki/Camisea_Gas_Project (-11.8387, -72.9503).
// Idea tomada de la portada de portolan-sdi.org. Los puntos se calculan en la build.
// El cuadro del catálogo (árbol, mapa con tabla de row groups y pirámide del COG) está adaptado
// de portolan-sdi.org (Apache-2.0): ver src/lib/catalogo-portolan.ts, NOTICE y
// LICENSES/portolan-sdi-APACHE-2.0.txt. Cambios en este archivo: árbol y dibujos en HTML y SVG
// (antes canvas), aparición con transiciones CSS al abrir la tarjeta, colores de Kipu360.
import { geoContains } from "d3-geo";
import { ARBOL, MAPA, TABLA, PIRAMIDE, filas, type Nodo } from "../lib/catalogo-portolan";
import { feature } from "topojson-client";
import land110 from "world-atlas/land-110m.json";
import countries50 from "world-atlas/countries-50m.json";

const tierra = feature(land110, land110.objects.land);
const peru = feature(countries50, countries50.objects.countries).features.find((f) => f.id === "604");

const r1 = (v) => Math.round(v * 10) / 10;
const r2 = (v) => Math.round(v * 100) / 100;
const mundo = [];
for (let lat = -58; lat <= 80; lat += 2.4) {
  const paso = 2.4 / Math.max(Math.cos((lat * Math.PI) / 180), 0.25);
  for (let lon = -180; lon < 180; lon += paso) {
    if (geoContains(peru, [lon, lat])) continue;
    if (geoContains(tierra, [lon, lat])) mundo.push([r1(lon), r1(lat)]);
  }
}
const puntosPeru = [];
for (let lat = -18.5; lat <= 0.2; lat += 0.42) {
  for (let lon = -81.5; lon <= -68.5; lon += 0.42) {
    if (geoContains(peru, [lon, lat])) puntosPeru.push([r2(lon), r2(lat)]);
  }
}
const datos = JSON.stringify({ mundo, peru: puntosPeru });

// Orden de lectura de cada fila: marca el retraso de su fundido, de arriba abajo como en Portolan.
const orden = filas();
const num = (n: Nodo) => orden.indexOf(n);
const nivel1 = ARBOL.hijos ?? [];
---
<div class="globo" data-globo>
  <canvas class="globo__lienzo" width="560" height="560" aria-hidden="true"></canvas>
  <p class="globo__rotulo" data-rotulo aria-live="off"></p>
  <div class="globo__arbol" data-arbol role="group" aria-label="Ejemplo ilustrativo de catálogo Kipu360 para Camisea">
    <ul class="arbol">
      <li class="nodo nodo--raiz">
        <span class="fila" style={`--i:${num(ARBOL)}`}><span class="nombre fuerte">{ARBOL.nombre}</span></span>
        <ul>
          {nivel1.map((a) => (
            <li class="nodo">
              <span class="fila" style={`--i:${num(a)}`}>
                <span class={`nombre${a.tipo !== "archivo" ? " fuerte" : ""}`}>{a.nombre}</span>
                {a.formato && <span class="formato">{a.formato}</span>}
                {a.nota && <span class="nota">{a.nota}</span>}
              </span>
              {a.hijos && (
                <ul>
                  {a.hijos.map((b) => (
                    <li class="nodo">
                      <span class="fila" style={`--i:${num(b)}`}>
                        <span class={`nombre${b.tipo !== "archivo" ? " fuerte" : ""}`}>{b.nombre}</span>
                        {b.formato && <span class="formato">{b.formato}</span>}
                        {b.nota && <span class="nota">{b.nota}</span>}
                      </span>
                      {b.dibujo === "parquet" && (
                        <div class="dibujo dibujo--parquet" style={`--i:${num(b)}`} aria-hidden="true">
                          <div class="pq-mapa">
                            <svg viewBox={`0 0 ${MAPA.w} ${MAPA.h}`} preserveAspectRatio="xMinYMid meet">
                              <defs>
                                <path id="kq-tierra" d={MAPA.d} />
                                {MAPA.regiones.map((r, k) => (
                                  <clipPath id={`kq-region-${k}`}><rect x={r.x} y="-2" width={r.w} height={MAPA.h + 4} /></clipPath>
                                ))}
                              </defs>
                              {MAPA.regiones.map((r, k) => (
                                <use href="#kq-tierra" class="d-tierra" clip-path={`url(#kq-region-${k})`} fill-opacity={r.tinte} fill-rule="evenodd" />
                              ))}
                            </svg>
                          </div>
                          <svg class="pq-tabla" viewBox={`0 0 ${TABLA.vw} ${TABLA.vh}`} width={TABLA.vw} height={TABLA.vh}>
                            <g class="d-fin">
                              {TABLA.celdas.filter((c) => c.tinte > 0).map((c) => (
                                <rect class="d-tinte" x={c.x} y={c.y} width={c.w} height={c.h} fill-opacity={c.tinte} />
                              ))}
                              <text class="d-etiqueta" x={TABLA.etiquetaX} y={TABLA.etiquetaY}>geometry</text>
                            </g>
                            <g class="d-estructura">
                              {TABLA.celdas.map((c) => (
                                <rect class="d-borde" x={c.x} y={c.y} width={c.w} height={c.h} />
                              ))}
                            </g>
                          </svg>
                        </div>
                      )}
                      {b.dibujo === "cog" && (
                        <div class="dibujo dibujo--cog" style={`--i:${num(b)}`} aria-hidden="true">
                          <svg viewBox={`0 0 ${PIRAMIDE.vw} ${PIRAMIDE.vh}`} width={PIRAMIDE.vw} height={PIRAMIDE.vh}>
                            <g class="d-estructura">
                              {PIRAMIDE.aristas.map(([x1, y1, x2, y2]) => (
                                <line class="d-arista" x1={x1} y1={y1} x2={x2} y2={y2} />
                              ))}
                            </g>
                            {PIRAMIDE.capas.map((c) => (
                              <g>
                                <polygon class="d-plano d-estructura" points={c.poligono} />
                                <path class={`d-pixeles ${c.k === 0 ? "d-lleno" : "d-fin"}`} d={c.pixeles} />
                                {c.k === 0 && (
                                  <g class="d-estructura">
                                    {PIRAMIDE.rejilla.map(([x1, y1, x2, y2]) => (
                                      <line class="d-rejilla" x1={x1} y1={y1} x2={x2} y2={y2} />
                                    ))}
                                  </g>
                                )}
                                <polygon class="d-borde d-estructura" points={c.poligono} />
                              </g>
                            ))}
                          </svg>
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </li>
    </ul>
    <p class="globo__pie">Ejemplo ilustrativo</p>
  </div>
  <script type="application/json" data-puntos set:html={datos}></script>
</div>

<style>
  .globo { position: relative; width: min(100%, 520px); aspect-ratio: 1; justify-self: end; }
  .globo__lienzo { width: 100%; height: 100%; display: block; }
  .globo__rotulo { position: absolute; left: 50%; bottom: -3%; transform: translateX(-50%); margin: 0; white-space: nowrap; font-family: var(--font-titulo); font-weight: 700; font-size: 0.95rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--azul-oscuro); transition: opacity 0.6s ease; }
  .globo.abierto .globo__rotulo { opacity: 0; }
  .globo__rotulo.mina { color: color-mix(in srgb, var(--naranja) 75%, var(--negro)); }

  /* Cuadro del catálogo, al estilo de portolan-sdi.org: árbol mono con conectores de 1 px,
     notas a la derecha, formato en azul y, bajo cada archivo de datos, su dibujo.
     Ocupa el 64 % derecho; el globo calcula su aro para dejar 12 px de aire (ver el script). */
  .globo__arbol { --conector: color-mix(in srgb, var(--azul-oscuro) 55%, var(--fondo-portada)); position: absolute; left: 36%; right: 0; top: 50%; translate: 0 -50%; padding: 10px 12px; background: var(--blanco); border: 1px solid color-mix(in srgb, var(--azul) 28%, transparent); color: var(--negro); overflow: hidden; opacity: 0; clip-path: inset(0 0 100% 0); transition: opacity 0.5s ease, clip-path 1.1s ease; pointer-events: none; }
  .globo.abierto .globo__arbol { opacity: 1; clip-path: inset(0 0 0 0); }
  .arbol, .arbol ul { list-style: none; margin: 0; padding: 0; }
  .arbol { font-family: var(--font-mono); font-size: 0.66rem; line-height: 15px; }
  .nodo { position: relative; }
  .arbol ul .nodo { padding-left: 14px; }
  .arbol ul .nodo::before { content: ""; position: absolute; left: 4px; top: 0; width: 6px; height: 8px; border-left: 1px solid var(--conector); border-bottom: 1px solid var(--conector); }
  .arbol ul .nodo:not(:last-child)::after { content: ""; position: absolute; left: 4px; top: 0; bottom: 0; border-left: 1px solid var(--conector); }
  .fila { display: flex; align-items: baseline; gap: 8px; height: 15px; white-space: nowrap; opacity: 0; transition: opacity 0.35s ease; transition-delay: calc(var(--i) * 80ms + 150ms); }
  .nombre { color: #4a4747; }
  .fuerte { font-weight: 600; color: var(--negro); }
  .formato, .nota { font-size: 0.56rem; opacity: 0; transition: opacity 0.4s ease; transition-delay: calc(var(--i) * 80ms + 450ms); }
  .formato { color: var(--azul-oscuro); }
  .nota { margin-left: auto; color: #5c5956; }
  .globo.abierto .fila, .globo.abierto .formato, .globo.abierto .nota { opacity: 1; }

  /* Dibujos: el mapa se descubre de oeste a este; tabla y planos, luego tintes y vistas generales. */
  .dibujo { margin: 3px 0 7px 2px; }
  .dibujo svg { display: block; overflow: visible; }
  .dibujo--parquet { display: flex; align-items: center; gap: 10px; }
  .pq-mapa { flex: 1 1 auto; min-width: 0; clip-path: inset(0 100% 0 0); transition: clip-path 0.9s ease; transition-delay: calc(var(--i) * 80ms + 300ms); }
  .pq-mapa svg { width: 100%; height: auto; aspect-ratio: 360 / 135; }
  .pq-tabla { flex: 0 0 auto; width: 110px; height: auto; }
  .dibujo--cog svg { width: min(100%, 190px); height: auto; }
  .globo.abierto .pq-mapa { clip-path: inset(-2px -2px -2px -2px); }
  .d-tierra { fill: var(--azul); stroke: var(--azul-oscuro); stroke-width: 0.8; }
  .d-tinte { fill: var(--azul); }
  .d-borde { fill: none; stroke: var(--azul-oscuro); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .d-etiqueta { font-family: var(--font-mono); font-size: 10px; fill: var(--azul-oscuro); }
  .d-plano { fill: var(--fondo-portada); }
  .d-pixeles { fill: var(--azul); fill-opacity: 0.55; }
  .d-arista { stroke: #c9d3ea; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .d-rejilla { stroke: var(--azul-oscuro); stroke-opacity: 0.4; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .d-estructura, .d-lleno, .d-fin { opacity: 0; transition: opacity 0.5s ease; }
  .d-lleno { transition-delay: calc(var(--i) * 80ms + 350ms); }
  .d-estructura { transition-delay: calc(var(--i) * 80ms + 650ms); }
  .d-fin { transition-delay: calc(var(--i) * 80ms + 1050ms); }
  .globo.abierto .d-estructura, .globo.abierto .d-lleno, .globo.abierto .d-fin { opacity: 1; }
  .globo__pie { margin: 8px 0 0; padding-top: 6px; border-top: 1px solid var(--linea); font-family: var(--font-mono); font-size: 0.62rem; line-height: 1.3; color: #7a7774; }
  @media (prefers-reduced-motion: reduce) {
    .globo__arbol, .globo__arbol * { transition: none !important; }
  }
  /* Entre 901 y 1040 px no caben globo y cuadro lado a lado: el globo se desvanece y el cuadro ocupa su lugar. */
  .globo__lienzo { transition: opacity 0.6s ease; }
  @media (max-width: 1040px) {
    .globo__arbol { left: 0; right: 0; }
    .globo.abierto .globo__lienzo { opacity: 0.08; }
  }
  /* Celular: el globo crece a 330 px y, al abrir, el cuadro ocupa su lugar (como en 901-1040 px).
     El margen vertical fijo deja sitio al cuadro, que es más alto que el globo: el texto no salta. */
  @media (max-width: 900px) {
    .globo { justify-self: center; width: min(100%, 330px); order: -1; margin-block: 40px calc(40px + var(--s-2)); }
    .globo__rotulo { bottom: -8%; font-size: 0.8rem; }
  }
</style>

<script>
  import { geoOrthographic, geoDistance, geoInterpolate, geoGraticule, geoPath } from "d3-geo";

  for (const raiz of document.querySelectorAll<HTMLElement>("[data-globo]")) {
    const lienzo = raiz.querySelector("canvas")!;
    const ctx = lienzo.getContext("2d")!;
    const rotulo = raiz.querySelector<HTMLElement>("[data-rotulo]")!;
    const datos = JSON.parse(raiz.querySelector("[data-puntos]")!.textContent!);
    const arbolEl = raiz.querySelector<HTMLElement>("[data-arbol]")!;
    // Modo compacto (1040 px o menos): el globo no se corre; el cuadro, si se muestra, va encima.
    const anchoCompacto = matchMedia("(max-width: 1040px)");
    const compacto = () => anchoCompacto.matches;
    const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const dpr = Math.min(devicePixelRatio || 1, 2);
    let lado = 0;
    // Borde izquierdo de la tarjeta dentro del globo: el aro abierto se detiene 12 px antes.
    let bordeTarjeta = 0;
    const AIRE = 12;
    const ajustar = () => {
      lado = lienzo.clientWidth;
      bordeTarjeta = arbolEl.offsetLeft;
      lienzo.width = lado * dpr;
      lienzo.height = lado * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    ajustar();
    addEventListener("resize", ajustar);

    const proyeccion = geoOrthographic().clipAngle(90);
    const RETICULA = geoGraticule().step([30, 30])();
    const PERU: [number, number] = [-75.5, -9.5];
    const MINA: [number, number] = [-72.9503, -11.8387]; // Camisea, Cusco
    const facil = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const tramo = (t: number, a: number, b: number) => Math.min(Math.max((t - a) / (b - a), 0), 1);

    // Línea de tiempo en segundos: gira, va al Perú, entra a la mina, abre el catálogo, vuelve.
    const CICLO = 19;
    function estado(t: number) {
      const giro = tramo(t, 0, 5);
      const alPeru = facil(tramo(t, 4.2, 7.2));
      const aMina = facil(tramo(t, 8, 10));
      const regreso = facil(tramo(t, 16.5, 19));
      const INICIO: [number, number] = [-5, 10];
      let centro: [number, number] = [INICIO[0] - 55 * giro, INICIO[1]];
      if (alPeru > 0) centro = geoInterpolate([INICIO[0] - 55, INICIO[1]], PERU)(alPeru) as [number, number];
      if (aMina > 0) centro = geoInterpolate(PERU, MINA)(aMina) as [number, number];
      if (regreso > 0) centro = geoInterpolate(MINA, INICIO)(regreso) as [number, number];
      const zoomPeru = 1 + 2.6 * alPeru;
      const zoomMina = zoomPeru * (1 + 2.2 * aMina);
      const zoom = regreso > 0 ? 1 + (zoomMina - 1) * (1 - regreso) : zoomMina;
      const lado_ = facil(tramo(t, 10.2, 11.2)) * (1 - facil(tramo(t, 16, 16.8)));
      return { centro, zoom, peru: alPeru, mina: aMina * (1 - regreso), abierto: t > 10.8 && t < 16.2, corrido: lado_, t };
    }

    function dibujar(s: ReturnType<typeof estado>) {
      const abre = compacto() ? 0 : s.corrido || 0;
      // Al abrir, el globo va a la izquierda: su aro (radio * 1,04, trazo de 1 px) va de 6 px
      // hasta AIRE px antes de la tarjeta, que ocupa el 64 % derecho.
      const aroAbierto = Math.max((bordeTarjeta - AIRE - 6 - 0.5) / 2, 10);
      const radio = lado * 0.43 * (1 - abre) + (aroAbierto / 1.04) * abre;
      const cx = lado * 0.5 * (1 - abre) + (6 + aroAbierto) * abre;
      proyeccion.scale(radio * s.zoom).translate([cx, lado / 2]).rotate([-s.centro[0], -s.centro[1]]);
      ctx.clearRect(0, 0, lado, lado);
      // Todo se dibuja dentro de un círculo fijo: al acercarse se ve como una lupa, no un cuadrado.
      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, lado / 2, radio * 1.04, 0, Math.PI * 2);
      ctx.clip();
      // Retícula cada 30°, fina, como en Portolan
      ctx.beginPath();
      geoPath(proyeccion, ctx)(RETICULA);
      ctx.strokeStyle = "rgba(0,61,226,0.22)";
      ctx.lineWidth = 1;
      ctx.stroke();

      const visible = (p: [number, number]) => geoDistance(p, s.centro) < Math.PI / 2 - 0.02;
      const punto = (p: [number, number], r: number) => {
        const xy = proyeccion(p);
        if (!xy || xy[0] < -10 || xy[1] < -10 || xy[0] > lado + 10 || xy[1] > lado + 10) return;
        ctx.rect(xy[0] - r, xy[1] - r, 2 * r, 2 * r);
      };
      const tam = Math.min(Math.max(1.4, radio / 150) * 0.85 * Math.sqrt(s.zoom), 3);
      ctx.beginPath();
      for (const p of datos.mundo) if (visible(p)) punto(p, tam);
      ctx.fillStyle = `rgba(0,61,226,${(0.9 - 0.45 * s.peru) * (1 - s.mina)})`;
      ctx.fill();
      ctx.beginPath();
      for (const p of datos.peru) if (visible(p)) punto(p, Math.min(tam * 0.55, 1.8));
      const aPeru = 0.75 + 0.25 * s.peru;
      ctx.fillStyle = `rgba(8,71,144,${Math.max(aPeru, 0)})`;
      ctx.fill();
      if (s.mina > 0.05) {
        // Camisea: un punto y un anillo que late. Sin estaciones inventadas.
        const xy = proyeccion(MINA);
        if (xy) {
          const pulso = (s.t % 1.6) / 1.6;
          ctx.beginPath();
          ctx.arc(xy[0], xy[1], 6 + 18 * pulso, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(221,127,61,${s.mina * (1 - pulso)})`;
          ctx.lineWidth = 2;
          ctx.stroke();
          ctx.beginPath();
          ctx.arc(xy[0], xy[1], 5, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(221,127,61,${s.mina})`;
          ctx.fill();
        }
      }
      ctx.restore();
      // Aro del globo, que se mueve con él
      ctx.beginPath();
      ctx.arc(cx, lado / 2, radio * 1.04, 0, Math.PI * 2);
      ctx.strokeStyle = "rgba(0,61,226,0.8)";
      ctx.lineWidth = 1;
      ctx.stroke();
      const texto = s.mina > 0.5 ? "Camisea, Cusco" : s.peru > 0.6 ? "Perú" : "";
      if (rotulo.textContent !== texto) rotulo.textContent = texto;
      rotulo.classList.toggle("mina", s.mina > 0.5);
      raiz.classList.toggle("abierto", s.abierto);
    }

    // ?globo-t=<segundos> congela un instante del ciclo (para capturas de validación).
    const fijo = new URLSearchParams(location.search).get("globo-t");
    if (fijo !== null && Number.isFinite(Number(fijo)) && fijo.trim() !== "") {
      dibujar(estado(Number(fijo) % CICLO));
      addEventListener("resize", () => dibujar(estado(Number(fijo) % CICLO)));
      continue;
    }

    if (quieto) {
      dibujar({ ...estado(12), abierto: true });
      continue;
    }
    let inicio = performance.now();
    let activo = true;
    new IntersectionObserver(([e]) => {
      activo = e.isIntersecting;
      if (activo) requestAnimationFrame(cuadro);
    }).observe(raiz);
    function cuadro(ahora: number) {
      if (!activo) return;
      const t = ((ahora - inicio) / 1000) % CICLO;
      dibujar(estado(t));
      requestAnimationFrame(cuadro);
    }
    requestAnimationFrame(cuadro);
  }
</script>
